[Unit]
Description=NVIDIA fan control + GPU power governor (UPS is a read-only input)
After=nvidia-persistenced.service nut-monitor.service
Wants=nvidia-persistenced.service nut-monitor.service

[Service]
Type=simple
# Reference unit. The canonical one on the fleet is the deploy team's Ansible template.
#
# ExecStart carries SAFETY LIMITS only. Operator settings (fan profile, mirror, temperature
# target, power ceiling) live in files in the StateDirectory and are changed live. A flag
# here would beat the file at every start and silently undo live changes. pve-ai values;
# derive --power-budget as ~0.85-0.9 x ups.realpower.nominal, and drop the UPS flags on
# hosts without a UPS.
ExecStart=/usr/bin/python3 /opt/nvidia-fan-control/nvidia-fan-control.py --interval 2 --temp-emergency 92 --power-budget 900 --ups cyberpower --power-interval 5 --power-fallback 150 --power-floor-on OB
ExecStop=/bin/kill -SIGTERM $MAINPID
# Re-read the settings files at once (they are also polled every ~2 s).
ExecReload=/bin/kill -SIGHUP $MAINPID
# NVML does NOT revert manual fans when the process dies (measured 2026-09-29), so hand
# every fan back to its factory curve after ANY exit, including a crash.
ExecStopPost=/usr/bin/python3 /opt/nvidia-fan-control/nvidia-fan-control.py --reset-fans
Restart=always
RestartSec=5

User=root
MemoryMax=128M

# /var/lib/nvidia-fan-control: saved settings (fan-profile, fan-mirror, temp-target,
#   power-ceiling) and runtime-state.json (learned trim, holds). Survives reboots.
StateDirectory=nvidia-fan-control
# /run/nvidia-fan-control: hand-run overrides, the lock, effective.json. Removed on stop,
#   which is what makes a restart clear temporary overrides.
RuntimeDirectory=nvidia-fan-control

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nvidia-fan-control

[Install]
WantedBy=multi-user.target
